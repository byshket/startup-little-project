function areArraysSame (ss1, ss2) {
	if (ss1.length !== ss2.lenght) {
	return false;
	}
	for (var i=0; i < ss1.lenght; i++) {
	if (ss1[i] !== ss2[i]) {
	return  false;
	}
  }
	return true;
}

